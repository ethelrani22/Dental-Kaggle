   "cell_type": "code",
   "source": "# ================== CELL 11: INFERENCE HELPERS (BRIDGE) ==================\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 11: Defining inference helpers (Stage 1 \u2192 Stage 2 bridge)')\nprint('='*60)\n\ndef crop_tooth_from_box(image_np, box, padding=CONFIG_S2['crop_padding']):\n    h, w = image_np.shape[:2]\n    x1 = max(0, int(box[0]) - padding)\n    y1 = max(0, int(box[1]) - padding)\n    x2 = min(w, int(box[2]) + padding)\n    y2 = min(h, int(box[3]) + padding)\n    return Image.fromarray(image_np[y1:y2, x1:x2])\n\ndef predict_tooth(crop_pil, model, device, img_size=CONFIG_S2['img_size'], threshold=CONFIG_S2['binary_threshold']):\n    tfm = transforms.Compose([\n        transforms.Resize((img_size, img_size)),\n        transforms.ToTensor(),\n        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n    ])\n    x = tfm(crop_pil).unsqueeze(0).to(device)\n    model.eval()\n    with torch.no_grad():\n        prob = torch.sigmoid(model(x)).item()\n    return {\n        'label': 'ANOMALY' if prob >= threshold else 'NORMAL',\n        'probability_anomaly': round(prob, 4)\n    }\n\ndef run_stage2_on_stage1_output(image_np, stage1_predictions, stage2_model, device, threshold=CONFIG_S2['binary_threshold']):\n    results = []\n    for box, tooth_id, score in zip(\n        stage1_predictions['boxes'],\n        stage1_predictions['labels'],\n        stage1_predictions['scores']\n    ):\n        crop = crop_tooth_from_box(image_np, box)\n        pred = predict_tooth(crop, stage2_model, device, threshold=threshold)\n        results.append({\n            'tooth_id'           : int(tooth_id),\n            'box'                : box.tolist() if hasattr(box, 'tolist') else list(box),\n            'segmentation_score' : round(float(score), 4),\n            'anomaly_label'      : pred['label'],\n            'anomaly_probability': pred['probability_anomaly']\n        })\n    return results\n\nprint('  crop_tooth_from_box()           \u2014 crops one tooth from Stage 1 box')\nprint('  predict_tooth()                 \u2014 runs Stage 2 on one crop')\nprint('  run_stage2_on_stage1_output()   \u2014 bridges Stage 1 \u2192 Stage 2 for full image')\nprint('  \u2713 Bridge functions defined')",
   "metadata": {"trusted": true}
