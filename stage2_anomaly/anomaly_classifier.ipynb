   "source": "# ================== CELL 13: RUN FULL PIPELINE ON TEST SAMPLES ==================\n# FIX: Added guard assertions to fail fast with a clear message if\n# Stage 1 objects (`model`, `test_dataset`) are not in memory.\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 13: Running full pipeline on test samples')\nprint('='*60)\n\n# Guard: Stage 1 objects must be in memory\nassert 'model' in dir(), (\n    \"Stage 1 `model` not found in memory. \"\n    \"Run stage1_segmentation/teeth_segmentation.ipynb first \"\n    \"in the same Kaggle session before executing this cell.\"\n)\nassert 'test_dataset' in dir(), (\n    \"Stage 1 `test_dataset` not found in memory. \"\n    \"Run stage1_segmentation/teeth_segmentation.ipynb first.\"\n)\nprint('  \u2713 Stage 1 objects confirmed in memory')\n\nNUM_SAMPLES = min(3, len(test_dataset))\nprint(f'  Running on {NUM_SAMPLES} test samples from Stage 1 test set')\n\nfor i in range(NUM_SAMPLES):\n    print(f\"\\n{'='*60}\\n  SAMPLE {i+1} / {NUM_SAMPLES}\\n{'='*60}\")\n    image_tensor, _ = test_dataset[i]\n    visualize_pipeline(\n        image_tensor  = image_tensor,\n        stage1_model  = model,\n        stage2_model  = stage2_model,\n        device        = device,\n        sample_index  = i + 1\n    )\n\nprint(f\"\\n{'='*60}\")\nprint('  \u2713 STAGE 2 COMPLETE')\nprint(f'  Checkpoints : {CHECKPOINT_BEST}')\nprint(f'               {CHECKPOINT_FINAL}')\nprint(f'  Report      : {REPORT_PATH}')\nprint(f'  Curves      : /kaggle/working/stage2_curves.png')\nprint(f'  Visuals     : /kaggle/working/pipeline_sample_*.png')\nprint(f\"{'='*60}\")",
