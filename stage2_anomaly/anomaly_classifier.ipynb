   "cell_type": "code",
   "source": "# ================== CELL 2: CONFIG ==================\n# FIX: DENTEX_ANN_PATH and DENTEX_IMG_DIR are auto-detected from the\n# actual directory contents instead of being hardcoded filenames.\n# This handles naming variations across different dataset versions.\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 2: Configuration')\nprint('='*60)\n\nCONFIG_S2 = {\n    'seed': 42, 'batch_size': 32, 'lr': 1e-4, 'epochs': 15,\n    'img_size': 224, 'num_workers': 2, 'binary_threshold': 0.5,\n    'crop_padding': 8, 'weight_decay': 1e-4, 'lr_patience': 3, 'lr_factor': 0.5,\n}\n\nDENTEX_BASE = '/kaggle/input/datasets/truthisneverlinear/dentex-challenge-2023'\n\n# Task 3 directory (quadrant + enumeration + disease labels)\nQED_DIR = os.path.join(DENTEX_BASE, 'training_data', 'training_data', 'quadrant-enumeration-disease')\n\n# ── AUTO-DETECT annotation JSON ──────────────────────────────────────────────\n_json_candidates = sorted(glob.glob(os.path.join(QED_DIR, '*.json')))\nassert len(_json_candidates) > 0, (\n    f\"No JSON annotation file found in {QED_DIR}. \"\n    f\"Run Cell 2.5 inspector to check the actual directory structure.\"\n)\nDENTEX_ANN_PATH = _json_candidates[0]\nprint(f'  \u2713 Auto-detected annotation : {os.path.basename(DENTEX_ANN_PATH)}')\nif len(_json_candidates) > 1:\n    print(f'  \u26a0 Multiple JSONs found, using first: {_json_candidates}')\n\n# ── AUTO-DETECT image directory ───────────────────────────────────────────────\ndef _find_img_dir(base):\n    \"\"\"Return the sub-directory inside `base` that contains image files.\"\"\"\n    priority_names = ('xrays', 'images', 'imgs', 'panoramics')\n    if not os.path.isdir(base):\n        return None\n    # Priority: well-known names first\n    for name in priority_names:\n        candidate = os.path.join(base, name)\n        if os.path.isdir(candidate):\n            return candidate\n    # Fallback: any sub-dir holding PNG/JPG files\n    for entry in sorted(os.listdir(base)):\n        epath = os.path.join(base, entry)\n        if os.path.isdir(epath):\n            imgs = glob.glob(os.path.join(epath, '*.png')) + glob.glob(os.path.join(epath, '*.jpg'))\n            if len(imgs) > 0:\n                return epath\n    return None\n\nDENTEX_IMG_DIR = _find_img_dir(QED_DIR)\nassert DENTEX_IMG_DIR is not None, (\n    f\"No image directory found inside {QED_DIR}. \"\n    f\"Run Cell 2.5 inspector to view the actual contents.\"\n)\nprint(f'  \u2713 Auto-detected image dir  : {os.path.basename(DENTEX_IMG_DIR)}')\n\nCHECKPOINT_BEST  = '/kaggle/working/stage2_anomaly_best.pth'\nCHECKPOINT_FINAL = '/kaggle/working/stage2_anomaly_final.pth'\nREPORT_PATH      = '/kaggle/working/stage2_report.json'\n\nrandom.seed(CONFIG_S2['seed'])\nnp.random.seed(CONFIG_S2['seed'])\ntorch.manual_seed(CONFIG_S2['seed'])\nif torch.cuda.is_available(): torch.cuda.manual_seed_all(CONFIG_S2['seed'])\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n\nprint('\\n  Stage 2 configuration:')\nfor k, v in CONFIG_S2.items(): print(f'    {k:<22}: {v}')\nprint(f'\\n  DENTEX base dir    : {DENTEX_BASE}')\nprint(f'  QED sub-dir        : {QED_DIR}')\nprint(f'  Image dir          : {DENTEX_IMG_DIR}')\nprint(f'  Annotation file    : {DENTEX_ANN_PATH}')\nprint(f'  Device             : {device}')\nprint('  \u2713 Config complete')",
   "metadata": {"trusted": true}
