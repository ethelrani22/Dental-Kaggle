   "source": "# ================== CELL 2.5: DATASET STRUCTURE INSPECTION ==================\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 2.5: Dataset file & directory structure')\nprint('='*60)\n\nDEPTH_LIMIT = 4\nFILE_SAMPLE  = 5\n\ndef inspect_directory(base_path, depth_limit=DEPTH_LIMIT, file_sample=FILE_SAMPLE):\n    if not os.path.exists(base_path):\n        print(f'  \u2717 Path does not exist: {base_path}')\n        return\n    print(f'\\n  Root: {base_path}')\n    def _walk(path, prefix, current_depth):\n        if current_depth > depth_limit:\n            return\n        try:\n            entries = sorted(os.listdir(path))\n        except PermissionError:\n            print(f'{prefix}  [Permission denied]')\n            return\n        dirs  = [e for e in entries if os.path.isdir(os.path.join(path, e))]\n        files = [e for e in entries if os.path.isfile(os.path.join(path, e))]\n        for d in dirs:\n            print(f'{prefix}\u251c\u2500\u2500 \U0001f4c1 {d}/')\n            _walk(os.path.join(path, d), prefix + '\u2502   ', current_depth + 1)\n        shown = files[:file_sample]\n        for fname in shown:\n            fpath = os.path.join(path, fname)\n            size_kb = os.path.getsize(fpath) / 1024\n            print(f'{prefix}\u251c\u2500\u2500 \U0001f4c4 {fname}  ({size_kb:.1f} KB)')\n        if len(files) > file_sample:\n            print(f'{prefix}\u2514\u2500\u2500 ... and {len(files) - file_sample} more files (total: {len(files)})')\n    _walk(base_path, '  ', 1)\n\n# \u2500\u2500 1. DENTEX Challenge dataset (depth=4) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nprint('\\n[1] DENTEX Challenge 2023 dataset:')\ninspect_directory(DENTEX_BASE, depth_limit=4)\n\n# \u2500\u2500 2. Validate CONFIG paths \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nprint('\\n[2] Images directory summary:')\nif os.path.exists(DENTEX_IMG_DIR):\n    all_imgs = [f for f in os.listdir(DENTEX_IMG_DIR) if f.lower().endswith(('.png','.jpg','.jpeg'))]\n    ext_counts = {}\n    for f in all_imgs:\n        ext = os.path.splitext(f)[1].lower()\n        ext_counts[ext] = ext_counts.get(ext, 0) + 1\n    print(f'  Total image files : {len(all_imgs)}')\n    for ext, cnt in sorted(ext_counts.items()):\n        print(f'  {ext:<10}: {cnt} files')\n    print(f'  First 5           : {all_imgs[:5]}')\nelse:\n    print(f'  \u2717 Directory not found: {DENTEX_IMG_DIR}')\n\n# \u2500\u2500 3. Annotation file check \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nprint('\\n[3] Annotation file check:')\nif os.path.exists(DENTEX_ANN_PATH):\n    ann_size_mb = os.path.getsize(DENTEX_ANN_PATH) / (1024 * 1024)\n    print(f'  File    : {DENTEX_ANN_PATH}')\n    print(f'  Size    : {ann_size_mb:.2f} MB')\n    with open(DENTEX_ANN_PATH) as f:\n        ann_data = json.load(f)\n    if isinstance(ann_data, dict):\n        print(f'  Format  : dict \u2014 keys: {list(ann_data.keys())}')\n        if 'images'      in ann_data: print(f'  images      : {len(ann_data[\"images\"])} entries')\n        if 'annotations' in ann_data: print(f'  annotations : {len(ann_data[\"annotations\"])} entries')\n        if 'categories'  in ann_data:\n            cats = [(c['id'], c['name']) for c in ann_data['categories']]\n            print(f'  categories  : {cats}')\n    elif isinstance(ann_data, list):\n        print(f'  Format  : list \u2014 {len(ann_data)} top-level entries')\nelse:\n    print(f'  \u2717 File not found: {DENTEX_ANN_PATH}')\n\n# \u2500\u2500 4. All available Kaggle input datasets \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nprint('\\n[4] All available Kaggle input datasets:')\nkaggle_input = '/kaggle/input'\nif os.path.exists(kaggle_input):\n    for top in sorted(os.listdir(kaggle_input)):\n        tpath = os.path.join(kaggle_input, top)\n        n_items = len(os.listdir(tpath)) if os.path.isdir(tpath) else 0\n        print(f'  \U0001f4e6 {top}/  ({n_items} items)')\nelse:\n    print(f'  \u2717 /kaggle/input not found')\n\nprint('\\n  \u2713 Structure inspection complete')",
   "metadata": {"trusted": true}
