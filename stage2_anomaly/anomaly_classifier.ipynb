   "source": "# ================== CELL 9: TEST EVALUATION ==================\n# FIX: Added AUC-ROC metric via sklearn for clinical interpretability.\n# For anomaly detection, threshold-free AUC is more informative than F1 alone.\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 9: Test set evaluation')\nprint('='*60)\n\nckpt = torch.load(CHECKPOINT_BEST, map_location=device)\nstage2_model.load_state_dict(ckpt['model_state_dict'])\nstage2_model.eval()\nprint(f\"  Loaded: epoch {ckpt['epoch']}  val_f1={ckpt['val_f1']:.4f} | Evaluating on {len(test_ds)} samples\")\n\ntest_logits, test_labels_list = [], []\nwith torch.no_grad():\n    for images, labels in test_loader:\n        test_logits.append(stage2_model(images.to(device)).cpu())\n        test_labels_list.append(labels.unsqueeze(1))\n\nall_test_logits = torch.cat(test_logits)\nall_test_labels = torch.cat(test_labels_list)\n\ntm_test = compute_metrics(all_test_logits, all_test_labels, CONFIG_S2['binary_threshold'])\n\n# AUC-ROC (threshold-free)\nprobs_np  = torch.sigmoid(all_test_logits).numpy().flatten()\nlabels_np = all_test_labels.numpy().flatten()\ntry:\n    auc = roc_auc_score(labels_np, probs_np)\nexcept ValueError:\n    auc = float('nan')  # Only one class present in test set\n\nprint(f\"\\n  \u2500\u2500 Test Results \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\")\nprint(f\"  Accuracy     : {tm_test['acc']:.4f}  ({tm_test['acc']*100:.2f}%)\")\nprint(f\"  Precision    : {tm_test['precision']:.4f}\")\nprint(f\"  Recall       : {tm_test['recall']:.4f}\")\nprint(f\"  Specificity  : {tm_test['specificity']:.4f}\")\nprint(f\"  F1 Score     : {tm_test['f1']:.4f}\")\nprint(f\"  AUC-ROC      : {auc:.4f}\")\nprint(f\"  TP:{tm_test['tp']}  TN:{tm_test['tn']}  FP:{tm_test['fp']}  FN:{tm_test['fn']}\")\n\nreport = {\n    'timestamp'    : datetime.datetime.now().isoformat(),\n    'best_val_f1'  : best_val_f1,\n    'test_metrics' : {**tm_test, 'auc_roc': auc},\n    'history'      : history,\n    'config'       : CONFIG_S2\n}\nwith open(REPORT_PATH, 'w') as f:\n    json.dump(report, f, indent=2)\nprint(f'\\n  \u2713 Report saved: {REPORT_PATH}')",
