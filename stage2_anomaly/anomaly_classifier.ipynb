   "cell_type": "code",
   "source": "# ================== CELL 8: TRAINING ==================\n# FIX: Training loop now streams running confusion-matrix counts (tp/tn/fp/fn)\n# per batch instead of accumulating all logits in CPU RAM, which could OOM\n# on large datasets. Val loop still accumulates for AUC-ROC in Cell 9.\nprint('='*60)\nprint('STAGE 2 \u2014 CELL 8: Training')\nprint('='*60)\n\nbest_val_f1 = -1.0\nhistory     = {'train': [], 'val': []}\nstart_time  = time.time()\n\nprint(f'  Epochs: {CONFIG_S2[\"epochs\"]} | Batch: {CONFIG_S2[\"batch_size\"]} | Device: {device}')\nprint(f'  Started: {datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")}')\nprint('-' * 60)\n\nfor epoch in range(CONFIG_S2['epochs']):\n    epoch_start = time.time()\n\n    # ---- TRAIN (streaming counts) ----\n    stage2_model.train()\n    t_loss = 0.0\n    t_tp = t_tn = t_fp = t_fn = 0\n    threshold = CONFIG_S2['binary_threshold']\n\n    for images, labels in train_loader:\n        images = images.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True).unsqueeze(1)\n        logits = stage2_model(images)\n        loss   = criterion(logits, labels)\n        optimizer_s2.zero_grad()\n        loss.backward()\n        optimizer_s2.step()\n        t_loss += loss.item() * images.size(0)\n        # Streaming confusion matrix — no logit accumulation\n        with torch.no_grad():\n            preds = (torch.sigmoid(logits) >= threshold).float()\n            t_tp += ((preds == 1) & (labels == 1)).sum().item()\n            t_tn += ((preds == 0) & (labels == 0)).sum().item()\n            t_fp += ((preds == 1) & (labels == 0)).sum().item()\n            t_fn += ((preds == 0) & (labels == 1)).sum().item()\n\n    avg_t_loss  = t_loss / len(train_ds)\n    t_prec      = t_tp / max(1, t_tp + t_fp)\n    t_rec       = t_tp / max(1, t_tp + t_fn)\n    t_f1        = (2 * t_prec * t_rec / (t_prec + t_rec)) if (t_prec + t_rec) > 0 else 0.0\n    t_acc       = (t_tp + t_tn) / max(1, t_tp + t_tn + t_fp + t_fn)\n    tm = {'loss': avg_t_loss, 'acc': t_acc, 'precision': t_prec, 'recall': t_rec,\n          'f1': t_f1, 'tp': t_tp, 'tn': t_tn, 'fp': t_fp, 'fn': t_fn}\n\n    # ---- VALIDATION (accumulate logits for AUC in Cell 9 pattern) ----\n    stage2_model.eval()\n    v_loss, v_logits_all, v_labels_all = 0.0, [], []\n    with torch.no_grad():\n        for images, labels in val_loader:\n            images = images.to(device, non_blocking=True)\n            labels = labels.to(device, non_blocking=True).unsqueeze(1)\n            logits = stage2_model(images)\n            v_loss += criterion(logits, labels).item() * images.size(0)\n            v_logits_all.append(logits.cpu())\n            v_labels_all.append(labels.cpu())\n    avg_v_loss = v_loss / len(val_ds)\n    vm = compute_metrics(torch.cat(v_logits_all), torch.cat(v_labels_all), threshold)\n    vm['loss'] = avg_v_loss\n\n    history['train'].append(tm)\n    history['val'].append(vm)\n\n    prev_lr = optimizer_s2.param_groups[0]['lr']\n    scheduler.step(vm['f1'])\n    current_lr = optimizer_s2.param_groups[0]['lr']\n    lr_tag = ' [LR \u2193]' if current_lr < prev_lr else ''\n\n    saved = ''\n    if vm['f1'] > best_val_f1:\n        best_val_f1 = vm['f1']\n        torch.save({\n            'epoch': epoch + 1,\n            'model_state_dict': stage2_model.state_dict(),\n            'optimizer_state_dict': optimizer_s2.state_dict(),\n            'val_f1': best_val_f1,\n            'config': CONFIG_S2\n        }, CHECKPOINT_BEST)\n        saved = '  \u2190 BEST SAVED'\n\n    print(\n        f\"Epoch {epoch+1:02d}/{CONFIG_S2['epochs']} [{time.time()-epoch_start:.1f}s] \"\n        f\"| Train loss={avg_t_loss:.4f} f1={t_f1:.4f} \"\n        f\"| Val loss={avg_v_loss:.4f} f1={vm['f1']:.4f} \"\n        f\"prec={vm['precision']:.4f} rec={vm['recall']:.4f} spec={vm['specificity']:.4f} \"\n        f\"| lr={current_lr:.2e}{lr_tag}\" + saved\n    )\n\nprint('-' * 60)\nprint(f'  \u2713 Training complete in {(time.time()-start_time)/60:.1f} min | Best val F1: {best_val_f1:.4f}')\ntorch.save(stage2_model.state_dict(), CHECKPOINT_FINAL)\nprint(f'  \u2713 Final weights saved: {CHECKPOINT_FINAL}')",
