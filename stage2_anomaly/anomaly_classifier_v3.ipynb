      "source": "# ================== CELL 10: TEST ON DENTEX TRAINING IMAGES ==================\nprint('[CELL 10] Running pipeline on 3 DENTEX training images...')\n\ntest_imgs=sorted(glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.png'))[:5]+\n                 glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.jpg'))[:5])[:3]\n\nprint(f'  Images: {[os.path.basename(p) for p in test_imgs]}')\n\nfor i,img_path in enumerate(test_imgs):\n    print(f'\\n  ===== Image {i+1}/{len(test_imgs)}: {os.path.basename(img_path)} =====')\n    save_p=f'/kaggle/working/dental_analysis_{i+1}.png'\n    fig,_=run_full_pipeline(img_path,save_path=save_p)\n    plt.close(fig)\n\nprint('\\n[CELL 10] ✓ Done. /kaggle/working/ contents:')\nfor f in sorted(os.listdir('/kaggle/working/')):\n    print(f'  {f}  ({os.path.getsize("/kaggle/working/"+f)//1024} KB)')\n"
