      "source": "# ================== CELL 11: CUSTOM / VALIDATION IMAGE ==================\nprint('[CELL 11] Running on a DENTEX validation xray...')\n\n# Validation xrays have no labels -- pure inference only\nVAL_XRAY_DIR = '/kaggle/input/datasets/truthisneverlinear/dentex-challenge-2023/validation_data/validation_data/quadrant_enumeration_disease/xrays'\n\nif os.path.isdir(VAL_XRAY_DIR):\n    _cands=sorted(glob.glob(os.path.join(VAL_XRAY_DIR,'*.png'))+glob.glob(os.path.join(VAL_XRAY_DIR,'*.jpg')))\n    print(f'  Found {len(_cands)} validation images')\n    IMAGE_PATH=_cands[0] if _cands else None\n    if IMAGE_PATH: print(f'  Auto-selected: {os.path.basename(IMAGE_PATH)}')\nelse:\n    print(f'  ⚠ Val dir not found: {VAL_XRAY_DIR}')\n    # Fallback: use first training image\n    _fb=sorted(glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.png')))\n    IMAGE_PATH=_fb[0] if _fb else None\n    if IMAGE_PATH: print(f'  Fallback to training image: {os.path.basename(IMAGE_PATH)}')\n\nif IMAGE_PATH and os.path.isfile(IMAGE_PATH):\n    fig,anomaly_map=run_full_pipeline(IMAGE_PATH,save_path='/kaggle/working/dental_analysis_custom.png')\n    plt.close(fig)\n    print('\\n[CELL 11] ✓ Saved -> /kaggle/working/dental_analysis_custom.png')\nelse:\n    print('[CELL 11] ✗ No image found. Set IMAGE_PATH manually.')\n\nprint('\\n[CELL 11] Final /kaggle/working/ contents:')\nfor f in sorted(os.listdir('/kaggle/working/')):\n    print(f'  {f}  ({os.path.getsize("/kaggle/working/"+f)//1024} KB)')\n"
