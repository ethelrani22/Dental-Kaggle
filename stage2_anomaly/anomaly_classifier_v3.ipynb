      "source": "# ================== CELL 2: DENTEX DATASET (COCO + PER-IMAGE + YOLO) ==================\nprint('[CELL 2] Defining DentexAnomalyDataset (multi-format)...')\n\nclass DentexAnomalyDataset(Dataset):\n    \"\"\"\n    Supports 3 annotation formats auto-detected in Cell 1:\n      'coco'           - Single COCO JSON (images + annotations + categories)\n      'per_image_json' - One JSON per image (Supervisely / DENTEX per-image format)\n      'yolo'           - One .txt per image (YOLO normalised bbox format)\n    The DENTEX category_id mapping:\n      1 -> 1 (Caries), 2 -> 2 (Deep Caries), 3 -> 3 (Periapical Lesion), 4 -> 4 (Impacted Tooth)\n    \"\"\"\n    CATEGORY_MAP = {1:1, 2:2, 3:3, 4:4}\n\n    # ── COCO constructor ────────────────────────────────────────────────────\n    @classmethod\n    def from_coco(cls, img_dir, coco_json, file_list=None):\n        self = cls.__new__(cls)\n        self.img_dir = img_dir\n        self.fmt = 'coco'\n        print(f'  Loading COCO JSON: {os.path.basename(coco_json)}')\n        with open(coco_json) as f:\n            data = json.load(f)\n        # Build image_id -> filename map\n        id2file = {img['id']: img['file_name'] for img in data['images']}\n        # Build image_id -> list of (bbox, cat_id) map\n        id2anns = {}\n        skipped_cat = 0\n        for ann in data.get('annotations', []):\n            cid = ann.get('category_id', -1)\n            if cid not in self.CATEGORY_MAP:\n                skipped_cat += 1; continue\n            iid = ann['image_id']\n            if iid not in id2anns: id2anns[iid] = []\n            id2anns[iid].append({'bbox': ann['bbox'], 'cat': self.CATEGORY_MAP[cid]})\n        print(f'  Skipped {skipped_cat} annotations with unmapped category_id')\n        # Build samples: (img_path, list_of_anns)\n        self.samples = []\n        no_img = 0; no_ann = 0\n        _allowed = set(file_list) if file_list else None\n        for iid, fname in id2file.items():\n            basename = os.path.basename(fname)\n            if _allowed and basename not in _allowed: continue\n            # Try the image in img_dir, then use fname directly\n            candidate = os.path.join(img_dir, basename)\n            if not os.path.exists(candidate):\n                candidate = fname if os.path.exists(fname) else None\n            if candidate is None:\n                no_img += 1; continue\n            anns = id2anns.get(iid, [])\n            if not anns: no_ann += 1\n            self.samples.append((candidate, anns))\n        print(f'  ✓ {len(self.samples)} images loaded  '\n              f'(no_img={no_img}, no_ann={no_ann} — unannotated treated as all-healthy)')\n        if self.samples:\n            print(f'  First sample: {os.path.basename(self.samples[0][0])}  anns={len(self.samples[0][1])}')\n        return self\n\n    # ── Per-image / YOLO constructor ────────────────────────────────────────\n    def __init__(self, img_dir, label_dir, file_list=None, fmt='per_image_json'):\n        self.img_dir = img_dir\n        self.fmt = fmt\n        all_imgs = sorted(\n            glob.glob(os.path.join(img_dir,'*.png')) +\n            glob.glob(os.path.join(img_dir,'*.jpg'))\n        ) if file_list is None else [os.path.join(img_dir,f) for f in file_list]\n        self.samples = []\n        skipped = 0\n        ext = '.json' if fmt == 'per_image_json' else '.txt'\n        for img_path in all_imgs:\n            base = os.path.splitext(os.path.basename(img_path))[0]\n            lbl = os.path.join(label_dir, base + ext)\n            if os.path.exists(lbl): self.samples.append((img_path, lbl))\n            else: skipped += 1\n        print(f'  ✓ DentexAnomalyDataset({fmt}): {len(self.samples)} labelled  (skipped {skipped})')\n        if self.samples:\n            print(f'  First: {os.path.basename(self.samples[0][0])}')\n\n    def __len__(self): return len(self.samples)\n\n    def __getitem__(self, idx):\n        entry = self.samples[idx]\n        img_path = entry[0]\n        img = Image.open(img_path).convert('RGB')\n        w, h = img.size\n        t = TF.to_tensor(img)\n\n        if self.fmt == 'coco':\n            anns = entry[1]  # list of {'bbox':[x,y,w,h], 'cat':int}\n            boxes, labels = [], []\n            for a in anns:\n                bx,by,bw,bh = a['bbox']\n                x1,y1,x2,y2 = bx, by, bx+bw, by+bh\n                if x2-x1<2 or y2-y1<2: continue\n                boxes.append([x1,y1,x2,y2]); labels.append(a['cat'])\n        elif self.fmt == 'per_image_json':\n            boxes, labels = self._load_json(entry[1], w, h)\n        else:\n            boxes, labels = self._load_yolo(entry[1], w, h)\n\n        if not boxes:\n            target = {'boxes':torch.zeros((0,4),dtype=torch.float32),\n                      'labels':torch.zeros((0,),dtype=torch.int64),\n                      'image_id':torch.tensor([idx])}\n        else:\n            target = {'boxes':torch.tensor(boxes,dtype=torch.float32),\n                      'labels':torch.tensor(labels,dtype=torch.int64),\n                      'image_id':torch.tensor([idx])}\n        return t, target\n\n    def _load_yolo(self, path, w, h):\n        boxes, labels = [], []\n        for line in open(path):\n            p = line.strip().split()\n            if len(p)<5: continue\n            cid = int(p[0])+1\n            if cid not in self.CATEGORY_MAP: continue\n            cx,cy,bw,bh = map(float,p[1:5])\n            x1,y1 = (cx-bw/2)*w,(cy-bh/2)*h\n            x2,y2 = (cx+bw/2)*w,(cy+bh/2)*h\n            if x2-x1<2 or y2-y1<2: continue\n            boxes.append([x1,y1,x2,y2]); labels.append(self.CATEGORY_MAP[cid])\n        return boxes, labels\n\n    def _load_json(self, path, w, h):\n        boxes, labels = [], []\n        data = json.load(open(path))\n        for ann in data.get('annotations', data.get('objects', [])):\n            cid = ann.get('category_id', ann.get('label_id', -1))\n            if cid not in self.CATEGORY_MAP: continue\n            if 'bbox' in ann:\n                bx,by,bw,bh=ann['bbox']; x1,y1,x2,y2=bx,by,bx+bw,by+bh\n            elif 'points' in ann:\n                pts=np.array(ann['points']['exterior'])\n                x1,y1,x2,y2=pts[:,0].min(),pts[:,1].min(),pts[:,0].max(),pts[:,1].max()\n            else: continue\n            if x2-x1<2 or y2-y1<2: continue\n            boxes.append([x1,y1,x2,y2]); labels.append(self.CATEGORY_MAP[cid])\n        return boxes, labels\n\nprint('[CELL 2] ✓ DentexAnomalyDataset defined.')\n\n# ── Build datasets using the auto-detected mode ──────────────────────────────\nprint(f'\\n[CELL 2] Building datasets  mode={ANNOTATION_MODE}')\n\nif ANNOTATION_MODE == 'coco':\n    _full_ds = DentexAnomalyDataset.from_coco(DENTEX_TRAIN_IMG, COCO_JSON_PATH)\n    n_total  = len(_full_ds)\n    random.seed(42)\n    _indices = list(range(n_total)); random.shuffle(_indices)\n    n_train  = int(n_total * CONFIG2['train_ratio'])\n    n_val    = int(n_total * CONFIG2['val_ratio'])\n    print(f'  Total:{n_total}  Train:{n_train}  Val:{n_val}  Test:{n_total-n_train-n_val}')\n    # Subset by building new sample lists\n    def _subset(ds, idx_list):\n        sub = DentexAnomalyDataset.__new__(DentexAnomalyDataset)\n        sub.img_dir = ds.img_dir; sub.fmt = ds.fmt\n        sub.samples = [ds.samples[i] for i in idx_list]\n        return sub\n    train_ds = _subset(_full_ds, _indices[:n_train])\n    val_ds   = _subset(_full_ds, _indices[n_train:n_train+n_val])\n    test_ds  = _subset(_full_ds, _indices[n_train+n_val:])\nelse:\n    all_imgs = sorted([os.path.basename(p) for p in\n        glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.png')) +\n        glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.jpg'))])\n    random.seed(42); random.shuffle(all_imgs)\n    n_total=len(all_imgs)\n    n_train=int(n_total*CONFIG2['train_ratio'])\n    n_val  =int(n_total*CONFIG2['val_ratio'])\n    _fmt = 'per_image_json' if ANNOTATION_MODE=='per_image_json' else 'yolo'\n    train_ds = DentexAnomalyDataset(DENTEX_TRAIN_IMG, PER_IMG_LABEL_DIR, file_list=all_imgs[:n_train],              fmt=_fmt)\n    val_ds   = DentexAnomalyDataset(DENTEX_TRAIN_IMG, PER_IMG_LABEL_DIR, file_list=all_imgs[n_train:n_train+n_val], fmt=_fmt)\n    test_ds  = DentexAnomalyDataset(DENTEX_TRAIN_IMG, PER_IMG_LABEL_DIR, file_list=all_imgs[n_train+n_val:],        fmt=_fmt)\n\nprint(f'[CELL 2] Labelled  train:{len(train_ds)}  val:{len(val_ds)}  test:{len(test_ds)}')\n\n# Guard: abort if we have absolutely no labelled training images\nif len(train_ds) == 0:\n    print('[CELL 2] ✗ FATAL: 0 labelled training images found!')\n    print('  Dumping first 20 files in QED folder tree for diagnosis:')\n    for root, dirs, files in os.walk(_qed):\n        for f in files[:20]: print(f'    {os.path.join(root,f)}')\n    raise RuntimeError('No labelled samples. See dump above to identify correct label path/format.')\n\n# Smoke-test sample 0\n_t, _tgt = train_ds[0]\nprint(f'\\n[CELL 2] Smoke-test sample 0:')\nprint(f'  image tensor : {_t.shape}')\nprint(f'  boxes        : {_tgt["boxes"].shape} -> {_tgt["boxes"].tolist()[:2]}')\nprint(f'  labels       : {_tgt["labels"].tolist()[:10]}')\nprint('[CELL 2] ✓ Done.')\n"
    },
