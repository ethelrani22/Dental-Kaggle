      "outputs": [],
      "source": "# ================== CELL 1: SETUP & CONFIG ==================\nprint('[CELL 1] Starting setup...')\n\nimport os, json, random, glob\nimport numpy as np\nimport cv2\nfrom PIL import Image\nimport matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\n\nimport torch\nfrom torch.utils.data import Dataset, DataLoader\nimport torchvision\nfrom torchvision.models.detection.faster_rcnn import FastRCNNPredictor\nfrom torchvision.models.detection.mask_rcnn import MaskRCNNPredictor\nfrom torchvision.ops import nms\nimport torchvision.transforms.functional as TF\n\nprint(f'  PyTorch:     {torch.__version__}')\nprint(f'  Torchvision: {torchvision.__version__}')\nprint(f'  CUDA:        {torch.cuda.is_available()}')\nif torch.cuda.is_available():\n    print(f'  GPU:         {torch.cuda.get_device_name(0)}')\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nSTAGE1_WEIGHTS_DIR   = '/kaggle/input/datasets/ethelrani/maskrcnn-teeth-stage1-weights'\nSTAGE1_BEST_WEIGHTS  = os.path.join(STAGE1_WEIGHTS_DIR, 'maskrcnn_teeth_best.pth')\nSTAGE1_FINAL_WEIGHTS = os.path.join(STAGE1_WEIGHTS_DIR, 'maskrcnn_teeth_final.pth')\nDENTEX_DIR = '/kaggle/input/datasets/truthisneverlinear/dentex-challenge-2023'\nSTAGE2_BEST  = '/kaggle/working/stage2_anomaly_best.pth'\nSTAGE2_FINAL = '/kaggle/working/stage2_anomaly_final.pth'\n\n# ── Auto-detect QED subfolder ────────────────────────────────────────────────\ndef _find_subdir(base, *candidates):\n    for c in candidates:\n        p = os.path.join(base, c)\n        if os.path.isdir(p): return p\n    return None\n\n_qed = _find_subdir(DENTEX_DIR,\n    'quadrant_enumeration_disease',\n    'quadrant-enumeration-disease',\n    'training_data/training_data/quadrant_enumeration_disease',\n    'training_data/training_data/quadrant-enumeration-disease')\n\nif _qed is None:\n    print('[CELL 1] Full DENTEX tree (to find correct path):')\n    for root, dirs, _ in os.walk(DENTEX_DIR):\n        for d in dirs: print(' ', os.path.join(root, d))\n    raise RuntimeError('Cannot find quadrant_enumeration_disease folder')\n\nprint(f'[CELL 1] QED dir: {_qed}')\nprint(f'  Contents: {os.listdir(_qed)}')\n\nDENTEX_TRAIN_IMG = _find_subdir(_qed, 'train/images', 'xrays', 'images', 'train') or _qed\nprint(f'  DENTEX_TRAIN_IMG : {DENTEX_TRAIN_IMG}')\nprint(f'  Contents (first 10): {os.listdir(DENTEX_TRAIN_IMG)[:10]}')\n\n# ── Scan the entire QED folder for annotation files ──────────────────────────\nprint('\\n[CELL 1] Scanning for annotation files...')\n_all_files_in_qed = []\nfor root, dirs, files in os.walk(_qed):\n    for f in files:\n        _all_files_in_qed.append(os.path.join(root, f))\n_ann_files = [f for f in _all_files_in_qed\n              if f.endswith('.json') or f.endswith('.txt')]\nprint(f'  Found {len(_ann_files)} annotation files:')\nfor f in _ann_files[:30]:\n    print(f'    {f}')\nif len(_ann_files) > 30:\n    print(f'    ... and {len(_ann_files)-30} more')\n\n# ── Determine annotation mode ────────────────────────────────────────────────\n# Mode A: Single COCO JSON (e.g. train.json / train_quadrant_enumeration_disease.json)\n# Mode B: Per-image JSON files in the same dir as images\n# Mode C: YOLO .txt files\n_coco_json_path = None\n_per_image_label_dir = None\n_annotation_mode = None\n\n_coco_candidates = [f for f in _ann_files if os.path.basename(f) in [\n    'train.json', 'val.json', 'test.json',\n    'train_quadrant_enumeration_disease.json',\n    'quadrant_enumeration_disease.json',\n    'annotations.json', 'instances_train.json'\n] or (os.path.basename(f).endswith('.json') and os.path.getsize(f) > 50_000)]\n\nif _coco_candidates:\n    # Pick the largest JSON (most likely the COCO annotation file)\n    _coco_json_path = max(_coco_candidates, key=os.path.getsize)\n    _annotation_mode = 'coco'\n    print(f'\\n[CELL 1] ANNOTATION MODE: COCO JSON')\n    print(f'  File: {_coco_json_path}  ({os.path.getsize(_coco_json_path)//1024} KB)')\n    # Peek inside to confirm structure\n    with open(_coco_json_path) as f:\n        _peek = json.load(f)\n    print(f'  Keys: {list(_peek.keys())}')\n    if 'images' in _peek: print(f'  images count: {len(_peek["images"])}')\n    if 'annotations' in _peek: print(f'  annotations count: {len(_peek["annotations"])}')\n    if 'categories' in _peek: print(f'  categories: {_peek["categories"]}')\nelse:\n    # Check for per-image JSON or YOLO txt\n    _per_img_jsons = [f for f in _ann_files if f.endswith('.json')]\n    _per_img_txts  = [f for f in _ann_files if f.endswith('.txt')]\n    _per_image_label_dir = os.path.dirname(_per_img_jsons[0]) if _per_img_jsons else (\n                           os.path.dirname(_per_img_txts[0]) if _per_img_txts else _qed)\n    _annotation_mode = 'per_image_json' if _per_img_jsons else 'yolo'\n    print(f'\\n[CELL 1] ANNOTATION MODE: {_annotation_mode.upper()}')\n    print(f'  Label dir: {_per_image_label_dir}')\n    print(f'  Sample files: {[os.path.basename(f) for f in (_per_img_jsons or _per_img_txts)[:5]]}')\n\nANNOTATION_MODE   = _annotation_mode\nCOCO_JSON_PATH    = _coco_json_path\nPER_IMG_LABEL_DIR = _per_image_label_dir\n\n# ── Anomaly classes ──────────────────────────────────────────────────────────\nANOMALY_CLASSES = {0:'background', 1:'Caries', 2:'Deep Caries', 3:'Periapical Lesion', 4:'Impacted Tooth'}\nNUM_ANOMALY_CLASSES = 5\n\nCONFIG2 = {'batch_size':2, 'lr':1e-4, 'epochs':30, 'conf_threshold':0.5,\n           'nms_iou':0.3, 'train_ratio':0.75, 'val_ratio':0.15,\n           'num_workers':2, 'crop_pad':10, 'min_crop_size':32}\nCONFIG1 = {'conf_threshold':0.6, 'nms_iou':0.3, 'padding':20}\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f'\\n[CELL 1] Device: {device}')\nprint(f'  Annotation mode: {ANNOTATION_MODE}')\n\n_n = len(glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.png'))) + len(glob.glob(os.path.join(DENTEX_TRAIN_IMG,'*.jpg')))\nprint(f'  Images in DENTEX_TRAIN_IMG: {_n}')\nprint('[CELL 1] ✓ Setup complete.')\n"
    },
