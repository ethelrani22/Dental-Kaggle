      "source": "# ================== CELL 8: PER-TOOTH DETECTION ==================\nprint('[CELL 8] Defining per-tooth anomaly detection...')\n\ndef crop_single_tooth(img_np, box, pad=CONFIG2['crop_pad']):\n    x1,y1,x2,y2=box; H,W=img_np.shape[:2]\n    return img_np[max(0,int(y1)-pad):min(H,int(y2)+pad),\n                  max(0,int(x1)-pad):min(W,int(x2)+pad)], None\n\ndef run_stage2_on_crop(crop_np, tooth_num=None):\n    if crop_np.shape[0]<CONFIG2['min_crop_size'] or crop_np.shape[1]<CONFIG2['min_crop_size']:\n        if tooth_num: print(f'    Tooth {tooth_num}: crop too small {crop_np.shape[:2]}, skip')\n        return []\n    rgb=cv2.cvtColor(crop_np,cv2.COLOR_GRAY2RGB) if crop_np.ndim==2 else crop_np.copy()\n    t=TF.to_tensor(Image.fromarray(rgb)).to(device)\n    stage2_model.eval()\n    with torch.no_grad():\n        pred=stage2_model([t])[0]\n    results=[]\n    for box,lbl,score in zip(pred['boxes'].cpu().numpy(),\n                              pred['labels'].cpu().numpy(),\n                              pred['scores'].cpu().numpy()):\n        if score<CONFIG2['conf_threshold']: continue\n        results.append({'label':int(lbl),'label_name':ANOMALY_CLASSES.get(int(lbl),'Unknown'),\n                        'score':float(score),'box':box.tolist()})\n    return results\n\ndef detect_anomalies(img_np, numbered_quads):\n    anomaly_map={}\n    total=sum(len(v) for v in numbered_quads.values())\n    print(f'  Running Stage 2 on {total} tooth crops...')\n    checked=0\n    for q_name,teeth in numbered_quads.items():\n        for tooth in teeth:\n            crop,_=crop_single_tooth(img_np,tooth['box'])\n            dets=run_stage2_on_crop(crop,tooth_num=tooth.get('number'))\n            checked+=1\n            if dets:\n                anomaly_map[tooth['number']]={'quadrant':q_name,'tooth':tooth,'anomalies':dets}\n                for d in dets:\n                    print(f'    ⚠ Tooth {tooth["number"]:>2} ({q_name}): {d["label_name"]}  conf={d["score"]:.2f}')\n    print(f'  Checked={checked}  Anomalous={len(anomaly_map)}  Healthy={checked-len(anomaly_map)}')\n    return anomaly_map\n\nprint('[CELL 8] ✓ Per-tooth helpers defined.')\n"
    },
    {
